{% extends "_layouts/cp" %}

{% block content %}
  {% set fortDateColTzHint = 'Dates use the system timezone ({tz}).'|t('fort', { tz: fortAppTimezone|default('') }) %}
  {% if fortCurrentIpExcluded|default(false) %}
    <div id="fort-excluded-ip-notice" class="pane tip">
      <p>{{ 'Your IP ({ip}) is in the Fort excluded list. Events are recorded for audit purposes, but this IP will not trigger alerts, notifications, or blocks.'|t('fort', { ip: fortRequestClientIp|default('—') }) }}</p>
    </div>
  {% endif %}
  {% set alertRows = fortAlertRows|default([]) %}

  {# ── Resolve active filter from URL param ── #}
  {% set _validAlertFilters = ['all', 'login_threshold', 'http_rate_limited'] %}
  {% set _requestedFilter = craft.app.request.getQueryParam('filter')|default('all') %}
  {% set activeAlertFilter = _requestedFilter in _validAlertFilters ? _requestedFilter : 'all' %}

  {# ── Compute tab counts ── #}
  {% set countAll = alertRows|length %}
  {% set countLogin = 0 %}
  {% set countRate = 0 %}
  {% for row in alertRows %}
    {% if row.alertType|default('') == 'login_threshold' %}
      {% set countLogin = countLogin + 1 %}
    {% elseif row.alertType|default('') == 'http_rate_limited' %}
      {% set countRate = countRate + 1 %}
    {% endif %}
  {% endfor %}

  {# ── Filter tabs ── #}
  <div id="fort-alerts-tabs" class="fort-filter-tabs">
    <button type="button" class="fort-filter-tab{{ activeAlertFilter == 'all' ? ' sel' : '' }}" data-filter="all" data-count="{{ countAll }}">{{ 'All'|t('fort') }}</button>
    <button type="button" class="fort-filter-tab{{ activeAlertFilter == 'login_threshold' ? ' sel' : '' }}" data-filter="login_threshold" data-count="{{ countLogin }}">{{ 'Login'|t('fort') }}</button>
    <button type="button" class="fort-filter-tab{{ activeAlertFilter == 'http_rate_limited' ? ' sel' : '' }}" data-filter="http_rate_limited" data-count="{{ countRate }}">{{ 'Rate limit'|t('fort') }}</button>
  </div>

  <div id="fort-alerts-table" class="pane tablepane hairline fort-alerts-table-pane">
    {% include 'fort/dashboard/_alerts-table' with { alertRows: alertRows, showFooter: true, footerId: 'fort-alerts-count', tzHint: fortDateColTzHint } only %}
  </div>

  <script>var fortInitialAlertFilter = {{ activeAlertFilter|json_encode|raw }};</script>
  {% include 'fort/dashboard/_styles' %}
  {% include 'fort/dashboard/_scripts' %}
{% endblock %}
