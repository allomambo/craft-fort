{% autoescape 'html' %}
<!DOCTYPE html>
<html lang="{{ language }}" style="color-scheme: light dark;">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>{{ heading }}</title>
  <style>
    :root { color-scheme: light dark; }
    @media only screen and (max-width: 620px) {
      .fort-wrap { width: 100% !important; max-width: 100% !important; }
    }
    @media (prefers-color-scheme: dark) {
      .fort-bg { background-color: #000000 !important; }
      .fort-text { color: #FFFFFF !important; }
      .fort-muted { color: #E4E4E4 !important; }
      .fort-line { border-bottom-color: #E4E4E4 !important; }
      .fort-rule { border-top-color: #E4E4E4 !important; }
      .fort-box { background-color: #000000 !important; border-color: #E4E4E4 !important; }
      .fort-pre, .fort-code { background-color: #F5EFED !important; color: #000000 !important; border: 0 !important; }
      .fort-link { color: #8BBDF8 !important; }
      .fort-btn { background-color: #FFFFFF !important; }
      .fort-btn a { color: #000000 !important; }
    }
  </style>
</head>
<body class="fort-bg" style="margin:0;padding:0;background:#FFFFFF;">
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">{{ preheader }}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="fort-bg" bgcolor="#FFFFFF" style="background:#FFFFFF;margin:0;padding:0;">
    <tr>
      <td align="center" bgcolor="#FFFFFF" style="padding:32px 16px;background:#FFFFFF;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" class="fort-wrap" style="width:600px;max-width:600px;">
          <tr>
            <td style="padding:0 0 16px;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td width="38" valign="middle" style="padding:0 6px 0 0;">
                    <img src="{{ iconSrc }}" width="32" height="32" alt="" style="display:block;border:0;outline:none;width:32px;height:32px;">
                  </td>
                  <td valign="middle" style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
                    <p class="fort-text" style="margin:0;font-size:18px;line-height:1;font-weight:600;color:#000000;">Fort</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td class="fort-box" bgcolor="#FFFFFF" style="background:#FFFFFF;border:1px solid #E4E4E4;border-radius:8px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                <tr>
                  <td style="padding:24px 28px 16px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
                    <table role="presentation" cellpadding="0" cellspacing="0">
                      <tr>
                        {% if siteIconSrc %}
                          <td width="44" valign="middle" style="padding:0 12px 0 0;">
                            <img src="{{ siteIconSrc }}" width="32" height="32" alt="" style="display:block;border:0;outline:none;width:32px;height:32px;border-radius:8px;">
                          </td>
                        {% endif %}
                        <td valign="middle">
                          <p class="fort-text" style="margin:0;font-size:14px;line-height:1.3;font-weight:600;color:#000000;">{{ siteName }}</p>
                          {% if siteUrl %}
                            <p style="margin:2px 0 0;font-size:13px;line-height:1.4;"><a class="fort-link" href="{{ siteUrl }}" style="color:#1D8EFF;text-decoration:none;">{{ siteHost ?: siteUrl }}</a></p>
                          {% endif %}
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                <tr>
                  <td class="fort-rule" style="border-top:1px solid #E4E4E4;padding:20px 28px 24px;">
                    <table role="presentation" cellpadding="0" cellspacing="0">
                      <tr>
                        <td width="28" valign="top" style="padding:2px 10px 0 0;">
                          {% if critical|default(false) %}
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 16 16" role="img" aria-hidden="true" style="display:block;">
                              <circle cx="8" cy="8" r="8" fill="#FF7A45"/>
                              <path fill="#000000" d="M4.6 5.6 5.6 4.6 8 7l2.4-2.4 1 1L9 8l2.4 2.4-1 1L8 9l-2.4 2.4-1-1L7 8Z"/>
                            </svg>
                          {% else %}
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 16 16" role="img" aria-hidden="true" style="display:block;">
                              <circle cx="8" cy="8" r="8" fill="#509467"/>
                              <path fill="#000000" d="M11.2 5.2 6.7 9.7 4.8 7.8 3.9 8.7 6.7 11.5 12.1 6.1Z"/>
                            </svg>
                          {% endif %}
                        </td>
                        <td valign="top" style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
                          <h1 class="fort-text" style="margin:0;font-size:16px;line-height:1.3;font-weight:600;color:#000000;">{{ heading }}</h1>
                          {% if intro %}
                            <p class="fort-muted" style="margin:4px 0 0;font-size:14px;line-height:1.5;color:#000000;">{{ intro|trim('.') }}.</p>
                          {% endif %}
                          {% for note in notes %}
                            <p class="fort-text" style="margin:4px 0 0;font-size:14px;line-height:1.5;color:#000000;">{{ note }}</p>
                          {% endfor %}
                          <table role="presentation" cellpadding="0" cellspacing="0" style="margin-top:16px;">
                            <tr>
                              <td class="fort-btn" bgcolor="#000000" style="background:#000000;border-radius:8px;padding:8px 16px;">
                                <a href="{{ actionUrl }}" style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;font-weight:600;line-height:20px;color:#FFFFFF;text-decoration:none;">{{ actionLabel }}</a>
                              </td>
                            </tr>
                          </table>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
                {% if stats or rows %}
                  <tr>
                    <td class="fort-rule" style="border-top:1px solid #E4E4E4;padding:8px 28px 16px;">
                      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                        {% for stat in stats %}
                          <tr>
                            <td class="fort-muted{% if not (loop.last and not rows) %} fort-line{% endif %}" style="padding:10px 16px 10px 0;{% if not (loop.last and not rows) %}border-bottom:1px solid #E4E4E4;{% endif %}font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.4;color:#000000;">{{ stat.label }}</td>
                            <td class="fort-text{% if not (loop.last and not rows) %} fort-line{% endif %}" align="right" style="padding:10px 0;{% if not (loop.last and not rows) %}border-bottom:1px solid #E4E4E4;{% endif %}font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.4;font-weight:600;color:#000000;">{{ stat.value }}</td>
                          </tr>
                        {% endfor %}
                        {% for row in rows %}
                          <tr>
                            <th class="fort-muted{% if not loop.last %} fort-line{% endif %}" scope="row" align="left" valign="top" style="width:38%;padding:10px 16px 10px 0;{% if not loop.last %}border-bottom:1px solid #E4E4E4;{% endif %}font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.4;font-weight:400;color:#000000;">{{ row.label }}</th>
                            <td class="fort-text{% if not loop.last %} fort-line{% endif %}" valign="top" style="padding:10px 0;{% if not loop.last %}border-bottom:1px solid #E4E4E4;{% endif %}font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.4;color:#000000;word-break:break-word;">
                              {% if row.code|default(false) %}<code class="fort-code" style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:13px;background:#F5EFED;padding:2px 6px;border:0;border-radius:4px;">{{ row.value }}</code>{% else %}{{ row.value }}{% endif %}
                            </td>
                          </tr>
                        {% endfor %}
                      </table>
                    </td>
                  </tr>
                {% endif %}
                {% if details %}
                  <tr>
                    <td class="fort-rule" style="border-top:1px solid #E4E4E4;padding:16px 28px 24px;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">
                      <details>
                        <summary class="fort-muted" style="font-size:14px;line-height:1.4;color:#000000;cursor:pointer;">{{ detailsLabel }}</summary>
                        <pre class="fort-pre" style="margin:8px 0 0;padding:12px 16px;background:#F5EFED;border:0;border-radius:8px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;line-height:1.45;color:#000000;white-space:pre-wrap;word-break:break-word;">{{ details }}</pre>
                      </details>
                    </td>
                  </tr>
                {% endif %}
              </table>
            </td>
          </tr>
          <tr>
            <td align="center" style="padding:28px 16px 0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.5;color:#000000;">
              <p class="fort-muted" style="margin:0;color:#000000;">{{ footer }}</p>
              {% if dateNote %}
                <p class="fort-muted" style="margin:8px 0 0;color:#000000;">{{ dateNote }}</p>
              {% endif %}
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
{% endautoescape %}
