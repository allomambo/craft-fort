<!DOCTYPE html>
<html lang="{{ language }}">
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <meta name="supported-color-schemes" content="light dark">
  <title>{{ heading }}</title>
  <style>
    @media (prefers-color-scheme: dark) {
      .fort-bg { background: #121417 !important; }
      .fort-card { background: #1c1f24 !important; border-color: #2c3138 !important; }
      .fort-ink { color: #f3f4f6 !important; }
      .fort-muted { color: #a1a7b0 !important; }
      .fort-rule { border-color: #2c3138 !important; }
      .fort-code { background: #2a2f36 !important; color: #f3f4f6 !important; }
      .fort-note { background: #2a2118 !important; border-color: #5c4326 !important; color: #fdba74 !important; }
      .fort-pre { background: #14171b !important; border-color: #2c3138 !important; color: #d1d5db !important; }
      .fort-btn { background: #f3f4f6 !important; }
      .fort-btn a { color: #111827 !important; }
    }
  </style>
</head>
<body class="fort-bg" style="margin:0;padding:0;background:#f3f4f6;">
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;">{{ preheader }}</div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="fort-bg" style="background:#f3f4f6;margin:0;padding:0;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="600" cellpadding="0" cellspacing="0" class="fort-card" style="width:600px;max-width:600px;background:#ffffff;border:1px solid #e5e7eb;border-radius:12px;border-collapse:separate;">
          <tr>
            <td style="height:4px;line-height:4px;font-size:0;background:{{ tone == 'alert' ? '#9f1239' : '#111827' }};border-radius:12px 12px 0 0;">&nbsp;</td>
          </tr>
          <tr>
            <td style="padding:28px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td class="fort-ink" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;font-weight:700;letter-spacing:0.16em;color:#111827;">FORT</td>
                  <td class="fort-muted" align="right" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:13px;color:#6b7280;">{{ siteName }}</td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:20px 32px 8px;">
              {% if kicker %}
                <p class="fort-muted" style="margin:0 0 6px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;color:#6b7280;">{{ kicker }}</p>
              {% endif %}
              <h1 class="fort-ink" style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:22px;line-height:1.3;font-weight:600;color:#111827;">{{ heading }}</h1>
              {% if code %}
                <p style="margin:10px 0 0;">
                  <code class="fort-code" style="font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;color:#111827;background:#f3f4f6;padding:3px 8px;border-radius:6px;">{{ code }}</code>
                </p>
              {% endif %}
              {% if intro %}
                <p class="fort-ink" style="margin:16px 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;line-height:1.5;color:#1f2937;">{{ intro }}</p>
              {% endif %}
            </td>
          </tr>
          {% if stats %}
            <tr>
              <td style="padding:8px 32px 0;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                  {% for stat in stats %}
                    <tr>
                      <td class="fort-muted fort-rule" style="padding:14px 0;border-bottom:1px solid #e5e7eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;color:#4b5563;">{{ stat.label }}</td>
                      <td class="fort-ink fort-rule" align="right" style="padding:14px 0;border-bottom:1px solid #e5e7eb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:20px;font-weight:600;font-variant-numeric:tabular-nums;color:#111827;">{{ stat.value }}</td>
                    </tr>
                  {% endfor %}
                </table>
              </td>
            </tr>
          {% endif %}
          {% if rows %}
            <tr>
              <td style="padding:8px 32px 0;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                  {% for row in rows %}
                    <tr>
                      <th class="fort-muted fort-rule" scope="row" align="left" valign="top" style="width:42%;padding:10px 12px 10px 0;border-bottom:1px solid #eef0f2;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:13px;font-weight:600;color:#6b7280;">{{ row.label }}</th>
                      <td class="fort-ink fort-rule" valign="top" style="padding:10px 0;border-bottom:1px solid #eef0f2;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#111827;word-break:break-word;">{{ row.value }}</td>
                    </tr>
                  {% endfor %}
                </table>
              </td>
            </tr>
          {% endif %}
          {% if notes %}
            <tr>
              <td style="padding:16px 32px 0;">
                {% for note in notes %}
                  <p class="fort-note" style="margin:0 0 8px;padding:12px 14px;background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;line-height:1.45;color:#9a3412;">{{ note }}</p>
                {% endfor %}
              </td>
            </tr>
          {% endif %}
          {% if details %}
            <tr>
              <td style="padding:20px 32px 0;">
                <p class="fort-muted" style="margin:0 0 8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;color:#6b7280;">{{ detailsLabel }}</p>
                <pre class="fort-pre" style="margin:0;padding:12px 14px;background:#f8fafc;border:1px solid #e5e7eb;border-radius:8px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;line-height:1.45;color:#1f2937;white-space:pre-wrap;word-break:break-word;">{{ details }}</pre>
              </td>
            </tr>
          {% endif %}
          <tr>
            <td style="padding:24px 32px 8px;">
              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td class="fort-btn" bgcolor="#111827" style="background:#111827;border-radius:8px;padding:12px 18px;">
                    <a href="{{ actionUrl }}" style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;font-weight:600;color:#ffffff;text-decoration:none;">{{ actionLabel }}</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td style="padding:8px 32px 28px;">
              {% if dateNote %}
                <p class="fort-muted" style="margin:0 0 6px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.45;color:#9ca3af;">{{ dateNote }}</p>
              {% endif %}
              <p class="fort-muted" style="margin:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;font-size:12px;line-height:1.45;color:#9ca3af;">{{ footer }}</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
